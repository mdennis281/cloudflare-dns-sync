# Copy this file to .env and paste in your Cloudflare API token.
# .env is gitignored, so the token stays out of version control.
#
# Create a token at https://dash.cloudflare.com/profile/api-tokens
# with these two permissions:  Zone > Zone > Read   and   Zone > DNS > Edit
#
# An exported CLOUDFLARE_API_TOKEN in the environment overrides this file.
CLOUDFLARE_API_TOKEN=your-api-token-here
